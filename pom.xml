<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.6</version>
        <relativePath/>
    </parent>

    <groupId>com.pacvue.lab</groupId>
    <artifactId>db-middleware-lab</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>db-middleware-lab</name>
    <description>Playground for exercising database / storage middleware (Elasticsearch, MySQL).</description>

    <modules>
        <module>middleware-lab-common</module>
        <module>middleware-lab-elasticsearch</module>
        <module>middleware-lab-mysql</module>
        <!-- Add one module per middleware under test, e.g.:
             <module>middleware-lab-shardingsphere</module>
             <module>middleware-lab-redis</module>
             <module>middleware-lab-clickhouse</module> -->
    </modules>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Container images under test. Bump per middleware version you want to verify. -->
        <elasticsearch.image>docker.elastic.co/elasticsearch/elasticsearch:8.18.6</elasticsearch.image>
        <mysql.image>mysql:8.0.46</mysql.image>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.pacvue.lab</groupId>
                <artifactId>middleware-lab-common</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
        <!-- testcontainers / junit / elasticsearch-java versions come from spring-boot-dependencies -->
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <configuration>
                        <includes>
                            <include>**/*IT.java</include>
                        </includes>
                        <!-- Without this, `-Dit.test=X` fails the build in every module that
                             does not contain X (including this pom-packaging parent). -->
                        <failIfNoSpecifiedTests>false</failIfNoSpecifiedTests>
                    </configuration>
                    <executions>
                        <execution>
                            <goals>
                                <goal>integration-test</goal>
                                <goal>verify</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
            </plugin>
            <!-- Repackages each module into an executable fat jar. Library-only modules
                 (middleware-lab-common) turn this off in their own pom. -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
